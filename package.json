    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/store.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}
